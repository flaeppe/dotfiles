## ctags 6.2.1 maps none of these extensions to a language, so without them
## every .tsx component and every .mts/.cts module is missing from the tag
## index entirely -- not merely tagged badly. --map-<LANG>= replaces the
## extension map, hence the leading + to append.
--map-TypeScript=+.tsx
--map-TypeScript=+.mts
--map-TypeScript=+.cts
--map-JavaScript=+.cjs

--exclude=.bash_env
--exclude=.git
--exclude=.mypy_cache
--exclude=.next
--exclude=.venv
--exclude=\*.bak
--exclude=\*.map
--exclude=\*.min.\*
--exclude=\*.swp
--exclude=bower_components
--exclude=min
--exclude=node_modules
--exclude=package-lock.json
--exclude=pnpm-lock.yaml
--exclude=tags
--exclude=.tags
--exclude=vendor
--exclude=.nox
--exclude=.tox
--exclude=\*.egg-info
--exclude=.pytest_cache
--exclude=build
--exclude=dist
--exclude=.direnv
--exclude=coverage
