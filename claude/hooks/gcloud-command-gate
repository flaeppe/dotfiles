#!/usr/bin/python3
"""Claude Code PreToolUse gate for `gcloud`: any `gcloud logging` call is
denied outright and redirected to `af log`, the read-only Cloud Logging
CLI; every other gcloud command needs approval, same as before.

`gcloud logging` used to get a narrow read-only allowlist here, parsed out of
the shell command line -- fragile by construction, since a call nested inside
another command's argument (`bash -c "gcloud logging read ..."`) escapes a
parser working off word position. `af` sidesteps the whole class of
problem: it is physically incapable of writes, so it can be allowlisted
wholesale (see ~/.dotfiles/claude/settings.json) instead of gated
command-by-command.

Answers with a permissionDecision so the verdict holds in every permission mode,
including the ones where a classifier would otherwise decide. Only a command
that invokes gcloud gets a verdict: text that merely carries the name, such as a
commit message or a grep pattern, gets none.

Composition does not soften the verdict. A real logging call practically never
arrives bare -- it comes wrapped in `timeout`, piped into `head`, chained behind
something else -- so the call is denied wherever on the line it sits, and the
denial covers the line entire, siblings included. The redirect stays accurate
about why the line was refused, and re-issuing a sibling on its own costs
nothing, where an `ask` would let the retired call through on one approval.

Shebang is an absolute path, not `env python3`: this hook fires from whatever
project directory the Bash tool is in, and a project's own direnv/flake shell
can shadow the global `python3` on PATH with an older interpreter version.
"""

from __future__ import annotations

import json
import sys
from typing import Final

import shellwords

# gcloud accepts its wide flags before the subcommand, so the command path has
# to be read past them. Only the separate-value form needs listing; `--flag=x`
# is a single word.
WIDE_FLAGS_WITH_VALUE: Final = frozenset(
    (
        "--access-token-file",
        "--account",
        "--billing-project",
        "--configuration",
        "--flags-file",
        "--flatten",
        "--format",
        "--impersonate-service-account",
        "--project",
        "--trace-token",
        "--user-output-enabled",
        "--verbosity",
    )
)

ANYFIN_LOG_REDIRECT: Final = (
    "gcloud logging is retired here -- use `af log read <filter> --since 1h` "
    "(read-only Cloud Logging CLI)"
)


def is_gcloud(word: str | None) -> bool:
    if not word:
        return False
    return word == "gcloud" or word.endswith("/gcloud")


def gcloud_invocations(words: list[str]) -> list[list[str]]:
    """Every gcloud call on the command line, each from its own gcloud word on.

    A sub-command runs gcloud where gcloud stands in its command position, which
    a pipeline segment and a wrapped call both have: `timeout 60 gcloud ... |
    head` runs gcloud. Anywhere else the name is an argument or a path -- a
    commit message quoting a gcloud command line is not a gcloud call and gets no
    verdict.

    Ceiling: a call nested inside another command's argument, as in
    `bash -c "gcloud ..."`, reads as an argument too. Scan inside words if that
    shows up.
    """
    invocations: list[list[str]] = []
    for segment in shellwords.sub_commands(words):
        command, index = shellwords.leading_command(segment)
        if is_gcloud(command):
            invocations.append(segment[index:])
    return invocations


def command_path(words: list[str]) -> list[str]:
    """The positional words of a gcloud invocation, in order."""
    path: list[str] = []
    index = 0
    while index < len(words):
        word = words[index]
        if word.startswith("-"):
            index += 2 if word in WIDE_FLAGS_WITH_VALUE else 1
            continue
        path.append(word)
        index += 1
    return path


def is_logging_command(invocation: list[str]) -> bool:
    """Whether a gcloud invocation, gcloud word included, is a logging one."""
    path = command_path(invocation[1:])
    return bool(path) and path[0] == "logging"


def decide(decision: str, reason: str) -> None:
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": decision,
                    "permissionDecisionReason": reason,
                }
            }
        )
    )


def main() -> None:
    payload = json.load(sys.stdin)
    if payload.get("tool_name") != "Bash":
        return

    command = payload.get("tool_input", {}).get("command", "")
    if "gcloud" not in command:
        return

    invocations = gcloud_invocations(shellwords.words_of(command))
    if not invocations:
        return
    if any(is_logging_command(invocation) for invocation in invocations):
        decide("deny", ANYFIN_LOG_REDIRECT)
        return
    decide("ask", "gcloud requires approval")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
