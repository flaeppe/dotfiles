#!/usr/bin/env python3
"""Claude Code PreToolUse gate for `gcloud`: read-only `gcloud logging` calls
run unprompted, every other gcloud command needs approval.

Answers with a permissionDecision so the verdict holds in every permission mode,
including the ones where a classifier would otherwise decide. Only a command
that invokes gcloud gets a verdict: text that merely carries the name, such as a
commit message or a grep pattern, gets none.
"""

from __future__ import annotations

import json
import sys
from typing import Final

import shellwords

# gcloud accepts its wide flags before the subcommand, so the command path has
# to be read past them. Only the separate-value form needs listing; `--flag=x`
# is a single word.
WIDE_FLAGS_WITH_VALUE: Final = frozenset(
    (
        "--access-token-file",
        "--account",
        "--billing-project",
        "--configuration",
        "--flags-file",
        "--flatten",
        "--format",
        "--impersonate-service-account",
        "--project",
        "--trace-token",
        "--user-output-enabled",
        "--verbosity",
    )
)

# Substitution runs a second command inside an argument, where quoting hides it
# from the word split -- `read "$(...)"` is one word. Whatever it runs is not
# covered by a verdict about gcloud.
SUBSTITUTION: Final = ("`", "$(")

# Command paths that only read, matched as a prefix of the positional words so
# any filter, resource name or flag may follow. `logging tail` is deliberately
# absent: it streams until killed, and a call that occupies the session is worth
# a prompt.
READ_ONLY: Final = frozenset(
    (
        ("logging", "read"),
        ("logging", "buckets", "describe"),
        ("logging", "buckets", "list"),
        ("logging", "logs", "list"),
        ("logging", "metrics", "describe"),
        ("logging", "metrics", "list"),
        ("logging", "operations", "describe"),
        ("logging", "operations", "list"),
        ("logging", "resource-descriptors", "list"),
        ("logging", "sinks", "describe"),
        ("logging", "sinks", "list"),
        ("logging", "views", "describe"),
        ("logging", "views", "list"),
    )
)


def is_gcloud(word: str | None) -> bool:
    if not word:
        return False
    return word == "gcloud" or word.endswith("/gcloud")


def invokes_gcloud(words: list[str]) -> bool:
    """Whether gcloud stands where a command starts.

    Elsewhere the name is an argument or a path -- a commit message quoting a
    gcloud command line is not a gcloud call and gets no verdict.

    Ceiling: a call nested inside another command's argument, as in
    `bash -c "gcloud ..."`, reads as an argument too. Scan inside words if that
    shows up.
    """
    return any(
        is_gcloud(shellwords.leading_command(segment)[0])
        for segment in shellwords.sub_commands(words)
    )


def runs_more_than_gcloud(words: list[str]) -> bool:
    """A decision covers the whole command line, so anything beyond the one
    gcloud call has to be asked about."""
    return any(
        shellwords.is_operator(word) or any(form in word for form in SUBSTITUTION)
        for word in words
    )


def command_path(words: list[str]) -> list[str]:
    """The positional words of a gcloud invocation, in order."""
    path: list[str] = []
    index = 0
    while index < len(words):
        word = words[index]
        if word.startswith("-"):
            index += 2 if word in WIDE_FLAGS_WITH_VALUE else 1
            continue
        path.append(word)
        index += 1
    return path


def is_read_only(words: list[str]) -> bool:
    path = command_path(words[1:])
    return tuple(path[:2]) in READ_ONLY or tuple(path[:3]) in READ_ONLY


def decide(decision: str, reason: str) -> None:
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": decision,
                    "permissionDecisionReason": reason,
                }
            }
        )
    )


def main() -> None:
    payload = json.load(sys.stdin)
    if payload.get("tool_name") != "Bash":
        return

    command = payload.get("tool_input", {}).get("command", "")
    if "gcloud" not in command:
        return

    words = shellwords.words_of(command)
    if not invokes_gcloud(words):
        return
    if not is_gcloud(words[0]):
        decide("ask", "gcloud runs as part of a larger command")
    elif runs_more_than_gcloud(words):
        decide("ask", "the command does more than run gcloud")
    elif not is_read_only(words):
        decide("ask", "not a read-only gcloud logging command")
    else:
        decide("allow", "read-only gcloud logging")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
