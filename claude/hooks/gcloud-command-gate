#!/usr/bin/python3
"""Claude Code PreToolUse gate for Cloud Monitoring and Cloud Logging access.

Input: a PreToolUse payload on stdin for a Bash tool call. Denies two things:

  * any command whose text contains `monitoring.googleapis.com` or
    `logging.googleapis.com` -- catching curl, wget, httpie, xh, or any other
    way of hitting those REST APIs directly, not just a named list of clients
  * a `gcloud logging ...` / `gcloud monitoring ...` invocation, wherever it
    sits on the command line -- including inside a pipe, `timeout`, or
    another wrapper

Each is redirected to the matching read-only wrapper CLI (`af log read` /
`af metrics query`). Every other gcloud invocation gets an `ask` verdict;
everything else gets no verdict.

Ceiling: the host match is a plain substring test over the whole command
text, so a command that only quotes or mentions one of those hostnames -- a
commit message, a comment, a grep pattern -- denies too. Narrower than that
needs parsing the command the way gcloud_invocations does for gcloud.
"""

from __future__ import annotations

import json
import sys
from typing import Final

import shellwords

# gcloud accepts its wide flags before the subcommand, so the command path has
# to be read past them. Only the separate-value form needs listing; `--flag=x`
# is a single word.
WIDE_FLAGS_WITH_VALUE: Final = frozenset(
    (
        "--access-token-file",
        "--account",
        "--billing-project",
        "--configuration",
        "--flags-file",
        "--flatten",
        "--format",
        "--impersonate-service-account",
        "--project",
        "--trace-token",
        "--user-output-enabled",
        "--verbosity",
    )
)

LOGGING_HOST: Final = "logging.googleapis.com"
MONITORING_HOST: Final = "monitoring.googleapis.com"

LOG_REDIRECT_MESSAGE: Final = (
    "Cloud Logging is retired here -- use `af log read <filter> --since 1h` "
    "(read-only Cloud Logging CLI)"
)

MONITORING_REDIRECT_MESSAGE: Final = (
    "Cloud Monitoring is retired here -- use `af metrics query <metric-type> "
    "[filter]` (read-only Cloud Monitoring CLI; `af metrics descriptor "
    "<metric-type>` lists field names)"
)


def is_gcloud(word: str | None) -> bool:
    if not word:
        return False
    return word == "gcloud" or word.endswith("/gcloud")


def gcloud_invocations(words: list[str]) -> list[list[str]]:
    """Every gcloud call on the command line, each from its own gcloud word on.

    A sub-command runs gcloud where gcloud stands in its command position, which
    a pipeline segment and a wrapped call both have: `timeout 60 gcloud ... |
    head` runs gcloud. Anywhere else the name is an argument or a path -- a
    commit message quoting a gcloud command line is not a gcloud call and gets no
    verdict.

    Ceiling: a call nested inside another command's argument, as in
    `bash -c "gcloud ..."`, reads as an argument too. Scan inside words if that
    shows up.
    """
    invocations: list[list[str]] = []
    for segment in shellwords.sub_commands(words):
        command, index = shellwords.leading_command(segment)
        if is_gcloud(command):
            invocations.append(segment[index:])
    return invocations


def command_path(words: list[str]) -> list[str]:
    """The positional words of a gcloud invocation, in order."""
    path: list[str] = []
    index = 0
    while index < len(words):
        word = words[index]
        if word.startswith("-"):
            index += 2 if word in WIDE_FLAGS_WITH_VALUE else 1
            continue
        path.append(word)
        index += 1
    return path


def gcloud_api_category(invocation: list[str]) -> str | None:
    """The API category ("logging" or "monitoring") a gcloud invocation,
    gcloud word included, targets; None otherwise."""
    path = command_path(invocation[1:])
    return path[0] if path and path[0] in ("logging", "monitoring") else None


def decide(decision: str, reason: str) -> None:
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": decision,
                    "permissionDecisionReason": reason,
                }
            }
        )
    )


def main() -> None:
    payload = json.load(sys.stdin)
    if payload.get("tool_name") != "Bash":
        return

    command = payload.get("tool_input", {}).get("command", "")

    if LOGGING_HOST in command:
        decide("deny", LOG_REDIRECT_MESSAGE)
        return
    if MONITORING_HOST in command:
        decide("deny", MONITORING_REDIRECT_MESSAGE)
        return

    if "gcloud" not in command:
        return

    invocations = gcloud_invocations(shellwords.words_of(command))
    if not invocations:
        return
    if any(gcloud_api_category(invocation) == "logging" for invocation in invocations):
        decide("deny", LOG_REDIRECT_MESSAGE)
        return
    if any(
        gcloud_api_category(invocation) == "monitoring" for invocation in invocations
    ):
        decide("deny", MONITORING_REDIRECT_MESSAGE)
        return
    decide("ask", "gcloud requires approval")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
