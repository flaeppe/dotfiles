#!/usr/bin/env python3
"""Claude Code PreToolUse guard: refuse edits to files that must only change by
deliberate human action -- secrets, lockfiles, git internals.

Denies with exit 2 so the reason reaches Claude. Any internal failure exits 0 --
a broken guard must never wedge a session.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from typing import Final

# Repo-relative escape hatch: one path prefix per line, '#' comments ignored.
ALLOWLIST_FILE: Final = ".claude/protected-path-allow"

EDIT_TOOLS: Final = ("Edit", "Write", "NotebookEdit", "MultiEdit")

LOCKFILES: Final = (
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "poetry.lock",
    "uv.lock",
    "Cargo.lock",
    "flake.lock",
    "go.sum",
    "Gemfile.lock",
    "composer.lock",
)

PROTECTED: Final = (
    (re.compile(r"(^|/)\.env(\.[^/]*)?$"), "holds secrets; edit it yourself"),
    (
        re.compile(r"(^|/)(%s)$" % "|".join(re.escape(name) for name in LOCKFILES)),
        "lockfile; regenerate it with the package manager",
    ),
    (re.compile(r"/\.git/"), "git internals; use a git command"),
)


def repo_root(path: str) -> str | None:
    """Enclosing work tree, or None outside a repo."""
    result = subprocess.run(
        ("git", "-C", os.path.dirname(path) or ".", "rev-parse", "--show-toplevel"),
        capture_output=True,
        text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def allowlist(root: str) -> tuple[str, ...]:
    try:
        with open(os.path.join(root, ALLOWLIST_FILE)) as handle:
            lines = handle.read().splitlines()
    except OSError:
        return ()
    return tuple(
        line.strip() for line in lines if line.strip() and not line.startswith("#")
    )


def main() -> int:
    payload = json.load(sys.stdin)
    if payload.get("tool_name") not in EDIT_TOOLS:
        return 0

    path = payload.get("tool_input", {}).get("file_path", "")
    if not path:
        return 0
    absolute = os.path.abspath(path)

    root = repo_root(absolute)
    relative = os.path.relpath(absolute, root) if root else absolute
    if root:
        allowed = allowlist(root)
        if allowed and relative.startswith(allowed):
            return 0

    for pattern, reason in PROTECTED:
        if pattern.search(relative) or pattern.search(absolute):
            print(
                "BLOCKED: %s -- %s.\n\n"
                "If this edit is genuinely intended, ask first, or add the path\n"
                "prefix to %s." % (relative, reason, ALLOWLIST_FILE),
                file=sys.stderr,
            )
            return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
