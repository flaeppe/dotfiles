#!/bin/bash
# SessionStart -> record the session in the state repo's session registry, so a
# session closed without an explicit end is still found and its crumbs
# extracted. Skipped for headless helper runs. Never blocks a session: an
# absent binary or any failure exits 0 silently.
[ -n "$SAM_HEADLESS" ] && exit 0
payload="$(cat)"
ME_HOME="${ME_HOME:-$(cat "$HOME/.config/me-home" 2>/dev/null)}"
sam="$ME_HOME/bin/sam"
if [ -n "$ME_HOME" ] && [ -x "$sam" ]; then
  (cd "$ME_HOME" && "$sam" crumbs register --pid "$PPID") <<<"$payload" 2>/dev/null
fi
exit 0
