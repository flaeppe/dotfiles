#!/usr/bin/env python3
"""Claude Code PreToolUse guard: refuse edits that introduce content the
instructions forbid outright.

Denies with exit 2 so the reason reaches Claude. Any internal failure exits 0 --
a broken guard must never wedge a session.
"""

from __future__ import annotations

import json
import os
import re
import sys
from collections.abc import Iterator, Mapping
from typing import Any, Final

# Escape hatch: set to any value to disable every rule for a session.
DISABLE: Final = "CLAUDE_SKIP_CONTENT_GUARD"

EDIT_TOOLS: Final = ("Edit", "Write", "MultiEdit")

TEST_FILE: Final = re.compile(r"(^test_[^/]*|[^/]*_test)\.py$")

BODY_FILE: Final = ("pr-body.md", "review-body.md")

# What the edit would introduce, and why that cannot stand.
Finding = tuple[str, str]

# Ceiling: single-line signatures only; one wrapped across lines slips through.
# Widen with a real parser if that shows up.
NONE_RETURN: Final = re.compile(
    r"^[ \t]*(async[ \t]+)?def[ \t]+test_\w*[ \t]*\([^)]*\)[ \t]*->[ \t]*None[ \t]*:",
    re.M,
)

# A bare #123. A qualified ref (owner/repo#123) or a URL keeps its '#'.
BARE_ISSUE_REF: Final = re.compile(r"(?<![\w/])#\d+\b")

FENCED_BLOCK: Final = re.compile(r"^```.*?^```", re.M | re.S)


def text_of(value: object) -> str:
    """A field of the tool payload as text, empty when it holds anything else."""
    return value if isinstance(value, str) else ""


def new_text(tool_name: str, tool_input: Mapping[str, Any]) -> str:
    """The text this edit would introduce."""
    if tool_name == "Write":
        return text_of(tool_input.get("content"))
    if tool_name == "Edit":
        return text_of(tool_input.get("new_string"))
    if tool_name == "MultiEdit":
        return "\n".join(
            text_of(edit.get("new_string")) for edit in tool_input.get("edits", ())
        )
    return ""


def none_return_finding(text: str) -> Finding | None:
    match = NONE_RETURN.search(text)
    if not match:
        return None
    return (
        "`-> None` on a pytest test function: %s" % match.group(0).strip(),
        "pytest ignores the return annotation on a test, so it is noise.\n"
        "No linter rule covers this -- ruff's ANN rules require annotations\n"
        "rather than forbid them. Drop the `-> None`.",
    )


def bare_issue_finding(text: str) -> Finding | None:
    match = BARE_ISSUE_REF.search(FENCED_BLOCK.sub("", text))
    if not match:
        return None
    return (
        "bare `%s`" % match.group(0),
        "GitHub renders it as a cross-reference to that issue. Write the plain\n"
        'number ("trap 2", not "trap #2"), or qualify it as owner/repo%s if you\n'
        "do mean to link." % match.group(0),
    )


def findings_for(path: str, text: str) -> Iterator[Finding | None]:
    name = os.path.basename(path)
    if TEST_FILE.search(name):
        yield none_return_finding(text)
    if name in BODY_FILE:
        yield bare_issue_finding(text)


def main() -> int:
    if os.environ.get(DISABLE):
        return 0

    payload = json.load(sys.stdin)
    tool_name = payload.get("tool_name")
    if tool_name not in EDIT_TOOLS:
        return 0

    tool_input = payload.get("tool_input", {})
    path = tool_input.get("file_path", "")
    if not path:
        return 0

    text = new_text(tool_name, tool_input)
    if not text:
        return 0

    for finding in findings_for(path, text):
        if not finding:
            continue
        what, why = finding
        print(
            "BLOCKED: %s would introduce %s.\n\n%s\n\n"
            "Set %s=1 to override for this session."
            % (os.path.basename(path), what, why, DISABLE),
            file=sys.stderr,
        )
        return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
