#!/bin/bash
# SessionEnd -> one inbox line in ME_HOME, via `me hook session-end`, and
# clears this session's kitty tab mark so a dead session never leaves one
# behind. Never blocks a session: an absent binary or any failure exits 0
# silently.
payload="$(cat)"
if [ -x "$HOME/.local/bin/me" ]; then
  "$HOME/.local/bin/me" hook session-end <<<"$payload" 2>/dev/null
fi
ME_HOME="${ME_HOME:-$(cat "$HOME/.config/me-home" 2>/dev/null)}"
sam="$ME_HOME/bin/sam"
if [ -n "$ME_HOME" ] && [ -x "$sam" ]; then
  (cd "$ME_HOME" && "$sam" session mark clear) <<<"$payload" 2>/dev/null
fi
exit 0
