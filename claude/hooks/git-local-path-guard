#!/usr/bin/python3
"""Claude Code PreToolUse guard: refuse `git commit`/`git push` that would
record a path which only exists on this machine.

Denies with exit 2 so the reason reaches Claude. Any internal failure exits 0 --
a broken guard must never wedge a session.

Shebang is an absolute path, not `env python3`: this hook fires from whatever
project directory the Bash tool is in, and a project's own direnv/flake shell
(e.g. an older Python pinned for Airflow) can shadow the global one on PATH --
a bare `env python3` there resolved to Python 3.8 and crashed on the `tuple[...]`
subscript syntax below (PEP 585, needs 3.9+).
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from collections.abc import Iterable, Iterator, Sequence
from typing import Final, NamedTuple

import shellwords

HOME: Final = os.path.expanduser("~")

# Where a local-only reference was found, the reference, and why it cannot travel.
Finding = tuple[str, str, str]

# Where plans and private notes live. Checked in file content too -- a reference
# to one is worthless to anyone who pulls the commit.
PLAN_FRAGMENTS: Final = ("_private/", ".plan/")

# Scratch trees and per-machine tool state. Checked on the paths being committed
# but not in content: tooling that manages these directories has to name them.
SCRATCH_FRAGMENTS: Final = (
    ".worktrees/",
    ".claude/worktrees/",
    ".claude/settings.local.json",
    ".review/",
)

# Ignore files list local-only paths on purpose -- an entry is the opposite of a
# leak, so their content is never scanned.
IGNORE_FILENAMES: Final = (
    ".gitignore",
    ".ignore",
    ".cbmignore",
    ".dockerignore",
    ".npmignore",
    ".eslintignore",
    ".prettierignore",
)

# A lockfile resolves a relative path from the workspace member that declared it,
# not from the lockfile, so there is no base this can resolve against. Only the
# relative check is skipped -- an absolute path in one is still a leak.
LOCKFILE_NAMES: Final = (
    "pnpm-lock.yaml",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "yarn.lock",
)

# Sources exempt from the content scan, one repo-relative path prefix per line.
# For files that legitimately document these paths as text.
ALLOWLIST_FILE: Final = ".claude/local-path-allow"

MAX_FINDINGS: Final = 12

# Seconds any one git subprocess may run before the guard gives up and allows the
# call. The variable exists so a test need not wait out the default.
GIT_TIMEOUT_SECONDS: Final = float(os.environ.get("GIT_LOCAL_PATH_GUARD_TIMEOUT", "10"))

# Git global flags that consume the following word, so the subcommand is not it.
GLOBAL_FLAGS_WITH_VALUE: Final = frozenset(
    ("-C", "-c", "--git-dir", "--work-tree", "--namespace", "--config-env")
)

# Characters that cannot appear inside a path, used to cut a line into tokens.
TOKEN_SEPARATORS: Final = re.compile(r"[^\w.@~${}/+-]+")

HOME_PREFIX: Final = re.compile(re.escape(HOME) + r"/|~/|\$\{?HOME\}?/")

STAGED_CHANGES: Final = ("diff", "--cached")

# What a merge in progress is merging in: the staged tree diffed against each of
# these shows what the merge resolution added beyond that parent.
MERGE_HEAD_FILE: Final = "MERGE_HEAD"

# Each commit reachable from HEAD but from no remote-tracking ref, diffed against
# its own parent: exactly what a push would publish. A range against the upstream
# branch cannot say that -- after a rebase its merge-base is the old fork point,
# so every commit the rebase pulled in from the default branch looks like the
# branch's own. Merge commits are skipped, which leaves out conflict resolutions
# made in a merge; any remote-tracking ref counts as published, whichever remote
# the push targets.
UNPUBLISHED_COMMITS: Final = (
    "log",
    "--no-merges",
    "--format=",
    "HEAD",
    "--not",
    "--remotes",
)


class GitTimeout(Exception):
    """A git subprocess outlived GIT_TIMEOUT_SECONDS."""


def git(directory: str, *args: str) -> str | None:
    """stdout of a git command, or None if it failed. Raises GitTimeout."""
    try:
        result = subprocess.run(
            ("git", "-C", directory, *args),
            capture_output=True,
            text=True,
            errors="replace",
            timeout=GIT_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired as expired:
        raise GitTimeout from expired
    if result.returncode != 0:
        return None
    return result.stdout


def merge_heads(repo_root: str) -> list[str]:
    """Commits being merged into HEAD, empty outside a merge. An octopus merge
    lists several."""
    relative = git(repo_root, "rev-parse", "--git-path", MERGE_HEAD_FILE)
    if not relative:
        return []
    try:
        with open(os.path.join(repo_root, relative.strip())) as handle:
            return handle.read().split()
    except OSError:
        return []


def staged_diffs(repo_root: str) -> list[Sequence[str]]:
    """Diff commands whose common additions are what this commit introduces.
    During a merge, everything the other parent brought in is already
    published, so a line only counts when it is new against every parent."""
    return [STAGED_CHANGES] + [
        (*STAGED_CHANGES, head) for head in merge_heads(repo_root)
    ]


class GitInvocation(NamedTuple):
    subcommand: str | None
    directory: str | None
    # Words after a bare `--`: a path-limited commit records only these paths.
    pathspec: tuple[str, ...]


def git_invocation(words: list[str], git_index: int) -> GitInvocation:
    """The subcommand, `-C` directory and `--` pathspec of the `git` word at git_index."""
    directory = None
    index = git_index + 1
    while index < len(words):
        word = words[index]
        if not word.startswith("-"):
            rest = words[index + 1 :]
            pathspec = tuple(rest[rest.index("--") + 1 :]) if "--" in rest else ()
            return GitInvocation(word, directory, pathspec)
        if word == "-C" and index + 1 < len(words):
            directory = words[index + 1]
        index += 2 if word in GLOBAL_FLAGS_WITH_VALUE else 1
    return GitInvocation(None, directory, ())


def git_invocations(command: str) -> list[GitInvocation]:
    """Each `git` standing in command position. The directory is the `-C`
    argument when given, else the target of the closest preceding `cd` in the
    same command line -- `cd <repo> && git commit` publishes from <repo>, not
    from the session cwd.

    A `git` inside a quoted string or in an argument is text someone wrote, not
    a command being run.
    """
    invocations: list[GitInvocation] = []
    cd_target: str | None = None
    words = shellwords.words_of(shellwords.without_heredocs(command))
    for segment in shellwords.sub_commands(words):
        word, index = shellwords.leading_command(segment)
        if word == "cd" and index + 1 < len(segment):
            candidate = segment[index + 1]
            if not candidate.startswith("-"):
                cd_target = candidate
        if word == "git":
            invocation = git_invocation(segment, index)
            invocations.append(
                invocation._replace(directory=invocation.directory or cd_target)
            )
    return invocations


def resolve_directory(candidate: str | None, cwd: str) -> str:
    """A `-C` argument as a usable directory, falling back to the session cwd."""
    if not candidate:
        return cwd
    expanded = os.path.expanduser(os.path.expandvars(candidate.strip("\"'")))
    absolute = expanded if os.path.isabs(expanded) else os.path.join(cwd, expanded)
    return absolute if os.path.isdir(absolute) else cwd


def is_inside(root: str, path: str) -> bool:
    return path == root or path.startswith(root + os.sep)


def path_tokens(text: str) -> list[str]:
    return [token for token in TOKEN_SEPARATORS.split(text) if "/" in token]


def sibling_root(directory: str) -> str | None:
    """The directory whose other children are neighbouring checkouts, worktrees
    and plan directories, or None when that would be $HOME or the filesystem
    root -- there the neighbours are ordinary config any machine may name."""
    common_dir = git(directory, "rev-parse", "--git-common-dir")
    if not common_dir:
        return None
    # Resolve from the main checkout so every linked worktree, nested or
    # alongside, agrees on where its neighbours live.
    main_checkout = os.path.dirname(
        os.path.abspath(os.path.join(directory, common_dir.strip()))
    )
    parent = os.path.dirname(main_checkout)
    return None if parent in (HOME, os.sep) else parent


class Repo:
    root: str
    siblings: str | None
    allowlist: tuple[str, ...]

    def __init__(self, root: str, siblings: str | None) -> None:
        self.root = root
        self.siblings = siblings
        self.allowlist = read_allowlist(root)

    def scans_content_of(self, path: str) -> bool:
        return not (
            path.startswith(self.allowlist)
            or os.path.basename(path) in IGNORE_FILENAMES
        )

    def resolves_relatives_of(self, path: str) -> bool:
        return os.path.basename(path) not in LOCKFILE_NAMES


def read_allowlist(repo_root: str) -> tuple[str, ...]:
    try:
        with open(os.path.join(repo_root, ALLOWLIST_FILE)) as handle:
            lines = handle.read().splitlines()
    except OSError:
        return ()
    return tuple(
        line.strip() for line in lines if line.strip() and not line.startswith("#")
    )


def classify(
    token: str,
    file_dir: str,
    repo: Repo,
    fragments: tuple[str, ...],
    resolve_relatives: bool = True,
) -> str | None:
    """Why this path token is local-only, or None if it is publishable."""
    token = token.rstrip(".,;:")

    for fragment in fragments:
        if fragment in token:
            return "local-only path (%s)" % fragment

    home_match = HOME_PREFIX.search(token)
    if home_match:
        target = os.path.normpath(os.path.join(HOME, token[home_match.end() :]))
        if is_inside(repo.root, target):
            return None
        if home_match.group().startswith(HOME):
            return "absolute path outside the repo"
        if repo.siblings and is_inside(repo.siblings, target):
            return "sits beside the repo, not inside it"
        return None

    if resolve_relatives and "../" in token:
        target = os.path.normpath(os.path.join(file_dir, token))
        if not is_inside(repo.root, target):
            return "escapes the repo root (-> %s)" % target

    return None


def pathspec_args(pathspec: Sequence[str]) -> tuple[str, ...]:
    return ("--", *pathspec) if pathspec else ()


def added_lines(
    repo_root: str, diff_command: Sequence[str], pathspec: Sequence[str] = ()
) -> Iterator[tuple[str, str, str]]:
    """(repo-relative path, absolute dir, added line) for each added diff line."""
    diff = git(
        repo_root,
        *diff_command,
        "--unified=0",
        "--no-color",
        "--patch",
        *pathspec_args(pathspec),
    )
    if diff is None:
        return
    path, file_dir = "", repo_root
    for line in diff.splitlines():
        if line.startswith("+++ "):
            target = line[4:]
            path = target[2:] if target.startswith("b/") else target
            file_dir = os.path.dirname(os.path.join(repo_root, path))
            continue
        if line.startswith("+"):
            yield path, file_dir, line[1:]


def changed_paths(
    repo_root: str, diff_command: Sequence[str], pathspec: Sequence[str] = ()
) -> list[str]:
    output = git(repo_root, *diff_command, "--name-only", *pathspec_args(pathspec))
    return [line for line in output.splitlines() if line] if output else []


def changed_in_all(
    repo_root: str, diff_commands: Sequence[Sequence[str]], pathspec: Sequence[str]
) -> list[str]:
    first, *others = (
        changed_paths(repo_root, command, pathspec) for command in diff_commands
    )
    return [path for path in first if all(path in other for other in map(set, others))]


def added_in_all(
    repo_root: str, diff_commands: Sequence[Sequence[str]], pathspec: Sequence[str]
) -> list[tuple[str, str, str]]:
    first, *others = (
        list(added_lines(repo_root, command, pathspec)) for command in diff_commands
    )
    return [line for line in first if all(line in other for other in map(set, others))]


def scan_diff(
    repo: Repo,
    label: str,
    diff_commands: Sequence[Sequence[str]],
    pathspec: Sequence[str] = (),
) -> Iterator[Finding]:
    """(location, token, reason) for every local-only reference that every git
    diff or log command in diff_commands reports as added, limited to pathspec
    when given."""
    for path in changed_in_all(repo.root, diff_commands, pathspec):
        reason = classify(path, repo.root, repo, PLAN_FRAGMENTS + SCRATCH_FRAGMENTS)
        if reason:
            yield "%s file" % label, path, reason

    for path, file_dir, line in added_in_all(repo.root, diff_commands, pathspec):
        if not repo.scans_content_of(path):
            continue
        resolve_relatives = repo.resolves_relatives_of(path)
        for token in path_tokens(line):
            reason = classify(token, file_dir, repo, PLAN_FRAGMENTS, resolve_relatives)
            if reason:
                yield path, token, reason


def scan_commit(
    repo: Repo, directory: str, publishing: Sequence[GitInvocation]
) -> Iterator[Finding]:
    """Findings in what the commit(s) in publishing would record. A path-limited
    commit (`git commit -- <paths>`) records those paths' working-tree content
    and ignores whatever else is staged, so only they are scanned."""
    pathspecs = [
        invocation.pathspec
        for invocation in publishing
        if invocation.subcommand == "commit"
    ]
    if not all(pathspecs):
        yield from scan_diff(repo, "staged", staged_diffs(repo.root))
        return
    # A relative pathspec is relative to the git call's directory, not the repo root.
    for pathspec in pathspecs:
        absolute = [
            word if word.startswith((":", os.sep)) else os.path.join(directory, word)
            for word in pathspec
        ]
        yield from scan_diff(repo, "staged", [("diff", "HEAD")], absolute)


def deduplicated(sources: Sequence[Iterable[Finding]]) -> list[Finding]:
    seen: set[Finding] = set()
    findings: list[Finding] = []
    for finding in (finding for source in sources for finding in source):
        if finding not in seen:
            seen.add(finding)
            findings.append(finding)
    return findings


def has_remotes(repo_root: str) -> bool:
    return bool((git(repo_root, "remote") or "").strip())


def deny(headline: str, findings: Sequence[Finding]) -> int:
    lines = ["BLOCKED: " + headline, ""]
    for location, token, reason in findings[:MAX_FINDINGS]:
        lines.append("  %s: %s  (%s)" % (location, token, reason))
    if len(findings) > MAX_FINDINGS:
        lines.append("  ... and %d more" % (len(findings) - MAX_FINDINGS))
    lines += [
        "",
        "Rewrite the reference so it resolves inside this repo, unstage the file,",
        "or add the source to %s if the path is documentation." % ALLOWLIST_FILE,
        "The whole command was refused: no step of it ran, including any before the git call.",
    ]
    print("\n".join(lines), file=sys.stderr)
    return 2


def main() -> int:
    payload = json.load(sys.stdin)
    if payload.get("tool_name") != "Bash":
        return 0

    command = payload.get("tool_input", {}).get("command", "")
    publishing = [
        invocation
        for invocation in git_invocations(command)
        if invocation.subcommand in ("commit", "push")
    ]
    if not publishing:
        return 0
    committing = any(invocation.subcommand == "commit" for invocation in publishing)
    pushing = any(invocation.subcommand == "push" for invocation in publishing)

    cwd = payload.get("cwd") or os.getcwd()
    directory = resolve_directory(
        next((invocation.directory for invocation in publishing if invocation.directory), None),
        cwd,
    )
    repo_root = git(directory, "rev-parse", "--show-toplevel")
    if not repo_root:
        return 0
    # A repo with no remote never leaves this machine, so a local path in it
    # resolves for everyone who can read it.
    if not has_remotes(repo_root.strip()):
        return 0
    repo = Repo(repo_root.strip(), sibling_root(directory))

    # Diffs only -- the paths being recorded and the lines being added. A
    # path-like token in a commit message is prose about the work, not a
    # reference that resolves for anyone who pulls it; scanning messages
    # blocked far more honest commits than it caught leaks.
    sources: list[Iterable[Finding]] = []
    if committing:
        sources.append(scan_commit(repo, directory, publishing))
    if pushing:
        sources.append(scan_diff(repo, "outgoing", [UNPUBLISHED_COMMITS]))

    findings = deduplicated(sources)
    if not findings:
        return 0

    what = "this commit" if committing else "these commits"
    return deny(
        "%s would record paths that only exist on this machine." % what, findings
    )


if __name__ == "__main__":
    try:
        sys.exit(main())
    except GitTimeout:
        print(
            "git-local-path-guard: git exceeded %gs; allowing the call"
            % GIT_TIMEOUT_SECONDS,
            file=sys.stderr,
        )
        sys.exit(0)
    except Exception:
        sys.exit(0)
