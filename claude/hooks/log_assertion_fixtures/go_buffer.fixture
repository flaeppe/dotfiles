package billing

import (
	"bytes"
	"strings"
	"testing"

	"github.com/rs/zerolog"
)

func TestSettleInvoice(t *testing.T) {
	var buf bytes.Buffer
	logger := zerolog.New(&buf)

	SettleInvoice(logger, "inv-1")

	if !strings.Contains(buf.String(), "settled inv-1") {
		t.Fatal("missing log line")
	}
}
