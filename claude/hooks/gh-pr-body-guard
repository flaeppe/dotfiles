#!/usr/bin/python3
"""Claude Code PreToolUse guard: refuse `gh pr create`/`gh pr edit` (and the
equivalent `gh api .../pulls` call) unless the body carries the `pr` skill's
marker, and unless the marked body passes the skill's content rules.

Two refusals:
1. No marker (including a body this hook cannot read at all, e.g. `--fill`,
   `gh pr create` with no body flag, or a `--body-file -`/`@-` stdin body):
   send the session to the skill. The refusal never prints the marker itself,
   or a session would paste it back without ever loading the skill.
2. Marker present, content lint fails: name the rule and quote the line.

A third refusal covers every other outward text write -- `gh pr comment`,
`gh pr review`, `gh issue comment`, `gh issue create` and `gh api` with a `body`
or `title` field. They need no marker, but text naming a local plan path is
refused, and a comment or review on a PR that is no longer open is refused
(`gh pr view --json state`). Replying to a thread you started only warns. A
failed or slow `gh` lookup lets the call through with a note on stderr: a guard
must not block on its own lookup.

Two things pass without a check: a `gh pr edit` that sets no body at all
(`--add-reviewer`, `--title`, ...), and a body file whose path only the shell
can resolve (`--body-file "$(mktemp)"`, a `$VAR` nothing here defines). The
second leaves a note on stderr, since the body goes unread.

Denies with exit 2 so the reason reaches Claude. Any internal failure exits 0
-- a broken guard must never wedge a session.

Shebang is an absolute path, not `env python3`, for the same reason as
git-local-path-guard beside it: a project's own direnv/flake shell can shadow
the global interpreter on PATH.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from typing import Final

import shellwords

MARKER: Final = "<!-- pr:v1 -->"

# `gh pr` verbs the owner's allow rules match only as the whole Bash command.
LONE_PR_WRITE_VERBS: Final = frozenset(("create", "edit", "ready", "comment"))

# Shell words that end one command and start another. Redirections (`>`, `2>&1`)
# and `$(...)` parentheses are not here: neither makes a second command.
COMMAND_SEPARATORS: Final = frozenset(("|", "||", "|&", "&", "&&", ";", ";;"))

# A PR's own description lives at `.../pulls` (create) or `.../pulls/<number>`
# (edit) -- sibling resources nested under a PR (`/comments`, `/reviews`,
# `/requested_reviewers`, ...) have more path after the number and don't
# match. An optional leading slash and `repos/<owner>/<repo>/` prefix cover
# how `gh api` endpoints are usually written.
PR_BODY_ENDPOINT: Final = re.compile(r"/?(repos/[^/]+/[^/]+/)?pulls(/\d+)?/?")

# Where plans and private notes live: a reference to one never resolves for a
# reader who only has GitHub and this repo.
PLAN_FRAGMENTS: Final = (
    ".plan/",
    "_cross/",
    "_private/",
    ".claude/plans/",
)

# Checked as a plain substring anywhere in a PR body.
LOCAL_ONLY_FRAGMENTS: Final = PLAN_FRAGMENTS + ("/Users/", "~/")

# `gh <noun> <verb>` pairs that publish free text without a `pr` skill marker.
PROSE_WRITE_VERBS: Final = frozenset(
    (
        ("pr", "comment"),
        ("pr", "review"),
        ("issue", "comment"),
        ("issue", "create"),
    )
)
# Prose flags of those verbs; the first group takes text, the second a file.
PROSE_TEXT_FLAGS: Final = frozenset(("--body", "-b", "--title", "-t"))
PROSE_FILE_FLAGS: Final = frozenset(("--body-file", "-F"))
# Flags of those verbs that consume a value, so the PR-reference scan does not
# take a flag's argument for the positional.
PROSE_VALUE_FLAGS: Final = PROSE_TEXT_FLAGS | PROSE_FILE_FLAGS | frozenset(("--repo", "-R"))

# Field names of a `gh api` write that carry text a reader sees.
API_PROSE_FIELDS: Final = frozenset(("body", "title"))
API_WRITE_METHODS: Final = frozenset(("POST", "PATCH", "PUT"))

# A comment or review under a PR: `pulls/<number>/comments|reviews[/...]`. The
# `{owner}/{repo}` placeholder gh fills in from the working directory is
# accepted as the repo. Ceiling: `issues/<number>/comments` also reaches a PR
# but cannot be told from an issue without a lookup, so it is not state-checked.
PR_CONVERSATION_ENDPOINT: Final = re.compile(
    r"/?(repos/(?P<repo>[^/]+/[^/]+)/)?pulls/(?P<number>\d+)/(comments|reviews)(/.*)?"
)
REVIEW_THREAD_REPLY: Final = re.compile(r".*/comments/(?P<comment>\d+)/replies/?")

CLOSED_PR_STATES: Final = frozenset(("CLOSED", "MERGED"))
LOOKUP_TIMEOUT_SECONDS: Final = 5

# Matched as a line prefix (after stripping leading whitespace).
FORBIDDEN_HEADINGS: Final = ("## Test plan", "## Testing", "## Verification")

MAX_PARAGRAPH_WORDS: Final = 80

# Two to three minutes of reading; detail past it belongs in a PR comment.
MAX_BODY_WORDS: Final = 450

# A line that opens a new markdown block, so it never continues the paragraph above it.
LIST_ITEM: Final = re.compile(r"([-*+]|\d+[.)])\s")

# `"$(cat <<'TAG' ... TAG)"`, the heredoc the pr skill writes its body with. A quoted
# delimiter turns expansion off, so the text between the markers is exactly what the
# shell hands to gh.
HEREDOC_SUBSTITUTION: Final = re.compile(
    r"\$\(\s*cat\s+<<-?\s*(['\"])(\w+)\1[ \t]*\n(?P<text>.*)\n[ \t]*\2[ \t]*\n?\s*\)",
    re.DOTALL,
)

# `gh api` global flags that consume a value, so the endpoint scan does not
# mistake a flag's argument for the positional endpoint.
API_VALUE_FLAGS: Final = frozenset(
    (
        "-H",
        "--header",
        "--jq",
        "--template",
        "--hostname",
        "--cache",
        "--input",
    )
)
API_FIELD_FLAGS: Final = frozenset(("-f", "-F", "--field", "--raw-field"))
API_METHOD_FLAGS: Final = frozenset(("-X", "--method"))

# A `$VAR`, `${VAR}`, `$(...)` or backtick: a word the shell rewrites before gh sees it.
SHELL_EXPANSION: Final = re.compile(r"[$`]")
VARIABLE_REFERENCE: Final = re.compile(r"\$(\w+|\{\w+\})")

# `gh` global flags that take a value, so the subcommand scan does not treat
# a flag's argument (e.g. the repo of `-R owner/repo`) as the subcommand.
GH_GLOBAL_FLAGS_WITH_VALUE: Final = frozenset(("-R", "--repo", "--hostname"))


def assigned_variables(command: str) -> dict[str, str]:
    """`NAME=value` words standing in front of a command, last one winning.

    Ceiling: where in the command an assignment sits is ignored, so one that
    follows its use still counts.
    """
    variables: dict[str, str] = {}
    for segment in shellwords.sub_commands(shellwords.words_of(command)):
        for word in segment:
            if word == "export":
                continue
            if not shellwords.ASSIGNMENT.match(word):
                break
            name, value = word.split("=", 1)
            variables[name] = value
    return variables


def expand_variables(path: str, variables: dict[str, str]) -> str:
    """`path` with each `$VAR`/`${VAR}` replaced from the command's own
    assignments, else from this hook's environment; one neither defines stays
    as written."""

    def value_of(reference: re.Match[str]) -> str:
        name = reference.group(1).strip("{}")
        return variables.get(name, os.environ.get(name, reference.group(0)))

    return VARIABLE_REFERENCE.sub(value_of, path)


def read_file(path: str, cwd: str) -> str | None:
    expanded = os.path.expanduser(path.strip("\"'"))
    absolute = expanded if os.path.isabs(expanded) else os.path.join(cwd, expanded)
    try:
        with open(absolute, encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except OSError:
        return None


def resolve_body_source(
    value: str, cwd: str, variables: dict[str, str]
) -> tuple[str | None, str] | None:
    """(body text, description) for a --body-file/-F value or a `gh api`
    `-f body=...` value. A None text means it could not be read -- refuse
    rather than guess, per `-` / `@-` meaning stdin, which this hook cannot see.
    None instead of a pair means the path goes through a shell expansion this
    hook cannot resolve to a readable file: the call is let through."""
    if value in ("-", "@-"):
        return None, "stdin body ('%s') can't be inspected" % value
    path = value[1:] if value.startswith("@") else value
    resolved = expand_variables(path, variables)
    text = None if SHELL_EXPANSION.search(resolved) else read_file(resolved, cwd)
    if text is None and SHELL_EXPANSION.search(path):
        print(
            "gh-pr-body-guard: body not checked, %s is a path only the shell can resolve"
            % path,
            file=sys.stderr,
        )
        return None
    if text is None:
        return None, "%s couldn't be read" % path
    return text, resolved


def flag_value(segment: list[str], index: int) -> tuple[str | None, int]:
    """(value, index following the flag and its value) for `--flag value` or
    `--flag=value` starting at index."""
    word = segment[index]
    if "=" in word:
        return word.split("=", 1)[1], index + 1
    if index + 1 < len(segment):
        return segment[index + 1], index + 2
    return None, index + 1


def gh_calls(command: str, cwd: str) -> list[tuple[list[str], int, str]]:
    """(sub-command words, index of `gh`, directory it runs in) for each `gh`
    standing in command position -- mirrors git-local-path-guard's
    `git_invocations`.

    Ceiling: a `cd` is followed wherever it sits in the command, branches of
    `||` and subshells included; one whose target needs the shell to resolve
    leaves the directory unchanged.
    """
    calls: list[tuple[list[str], int, str]] = []
    directory = cwd
    for segment in shellwords.sub_commands(shellwords.words_of(command)):
        word, index = shellwords.leading_command(segment)
        if word == "cd" and index + 1 < len(segment):
            target = os.path.expanduser(segment[index + 1])
            if not SHELL_EXPANSION.search(target):
                directory = os.path.join(directory, target)
        if word == "gh":
            calls.append((segment, index, directory))
    return calls


def gh_subcommand(segment: list[str], gh_index: int) -> tuple[str | None, int]:
    """(top-level gh command, its index), skipping global flags that take a
    value -- mirrors git-local-path-guard's `git_invocation`."""
    index = gh_index + 1
    while index < len(segment):
        word = segment[index]
        if not word.startswith("-"):
            return word, index
        index += 2 if word in GH_GLOBAL_FLAGS_WITH_VALUE else 1
    return None, index


def literal_body(value: str) -> str:
    """`value` with a quoted-heredoc command substitution replaced by its text;
    any other value unchanged."""
    match = HEREDOC_SUBSTITUTION.fullmatch(value)
    return match.group("text") if match else value


def pr_body(
    segment: list[str],
    start: int,
    cwd: str,
    variables: dict[str, str],
    creating: bool,
) -> tuple[str | None, str] | None:
    """(body text, description) for a `gh pr create`/`edit` invocation.
    None body means there is nothing to lint yet: --fill, no body flag on a
    create, or a body source that could not be read. None instead of a pair
    means the call needs no check: an edit that sets no body, or a body file
    the shell resolves."""
    index = start
    while index < len(segment):
        word = segment[index]
        flag = word.split("=", 1)[0]
        if flag in ("--body", "-b"):
            value, _ = flag_value(segment, index)
            if value is None:
                return None, "--body (empty)"
            return literal_body(value), "--body"
        if flag in ("--body-file", "-F"):
            value, _ = flag_value(segment, index)
            if value is None:
                return None, "--body-file (empty)"
            return resolve_body_source(value, cwd, variables)
        if word == "--fill" or word.startswith("--fill-"):
            return None, word
        index += 1
    return (None, "no body flag") if creating else None


@dataclass(frozen=True)
class ApiCall:
    endpoint: str | None
    method: str
    # (flag, key, value) for each `-f`/`-F`/`--field`/`--raw-field key=value`.
    fields: tuple[tuple[str, str, str], ...]
    # Value of `--input`, a file or `-` holding the whole request body.
    input_source: str | None


def parse_api_call(segment: list[str], start: int) -> ApiCall:
    endpoint: str | None = None
    method: str | None = None
    fields: list[tuple[str, str, str]] = []
    input_source: str | None = None
    index = start
    while index < len(segment):
        word = segment[index]
        flag = word.split("=", 1)[0]
        if word in API_METHOD_FLAGS:
            value, index = flag_value(segment, index)
            method = (value or "").upper()
            continue
        if word in API_FIELD_FLAGS:
            value, index = flag_value(segment, index)
            if value and "=" in value:
                key, field_value = value.split("=", 1)
                fields.append((word, key, field_value))
            continue
        if flag == "--input":
            input_source, index = flag_value(segment, index)
            continue
        if word in API_VALUE_FLAGS:
            _, index = flag_value(segment, index)
            continue
        if word.startswith("-"):
            index += 1
            continue
        if endpoint is None:
            endpoint = word
        index += 1
    if method is None:
        method = "POST" if fields or input_source else "GET"
    return ApiCall(endpoint, method, tuple(fields), input_source)


def api_pr_body(
    segment: list[str], start: int, cwd: str, variables: dict[str, str]
) -> tuple[str | None, str] | None:
    """(body text, description) if this `gh api` call POSTs/PATCHes a `body`
    field onto the PR's own description endpoint (`.../pulls` or
    `.../pulls/<number>`), else None -- it's not a call this guard covers.
    A reply to a review comment, an issue comment or a review submission
    targets a different endpoint: no marker is required of it.

    Ceiling: only `-f`/`-F`/`--field`/`--raw-field body=...` is read as the
    body. A JSON body from `--input <file>`/`--input -`, or a `gh api
    graphql` mutation, passes through unlinted -- add here if those show up.
    """
    call = parse_api_call(segment, start)
    endpoint = call.endpoint
    if not endpoint or not PR_BODY_ENDPOINT.fullmatch(endpoint.split("?", 1)[0]):
        return None
    bodies = [value for _, key, value in call.fields if key == "body"]
    if call.method not in ("POST", "PATCH") or not bodies:
        return None
    body = bodies[-1]
    # `-f key=value` is literal text; only `@file`/`@-` reads from disk/stdin.
    if body.startswith("@"):
        return resolve_body_source(body, cwd, variables)
    return body, endpoint


def pr_body_calls(command: str, cwd: str) -> list[tuple[str | None, str]]:
    """(body text or None, description) for every gh pr create/edit and
    body-bearing gh api .../pulls call in the command."""
    calls: list[tuple[str | None, str]] = []
    variables = assigned_variables(command)
    for segment, gh_index, directory in gh_calls(command, cwd):
        subcommand, sub_index = gh_subcommand(segment, gh_index)
        if subcommand == "pr" and sub_index + 1 < len(segment) and segment[
            sub_index + 1
        ] in ("create", "edit"):
            creating = segment[sub_index + 1] == "create"
            call = pr_body(segment, sub_index + 2, directory, variables, creating)
        elif subcommand == "api":
            call = api_pr_body(segment, sub_index + 1, directory, variables)
        else:
            continue
        if call is not None:
            calls.append(call)
    return calls


def chained_pr_write(command: str) -> str | None:
    """`gh pr <verb>` for a PR write that shares its Bash call with another
    command, a leading `cd` or `VAR=value` included; None otherwise.

    Ceiling: commands separated by a bare newline read as one command, so a
    newline-chained write goes unseen.
    """
    words = shellwords.words_of(shellwords.without_heredocs(command))
    segments: list[list[str]] = [[]]
    for word in words:
        if word in COMMAND_SEPARATORS:
            segments.append([])
            continue
        segments[-1].append(word)
    segments = [segment for segment in segments if segment]
    for segment in segments:
        word, gh_index = shellwords.leading_command(segment)
        if word != "gh":
            continue
        subcommand, sub_index = gh_subcommand(segment, gh_index)
        if subcommand != "pr" or sub_index + 1 >= len(segment):
            continue
        verb = segment[sub_index + 1]
        if verb not in LONE_PR_WRITE_VERBS:
            continue
        if len(segments) > 1 or gh_index > 0:
            return "gh pr %s" % verb
    return None


@dataclass(frozen=True)
class PullRequestTarget:
    """The PR a comment or review lands on. `reference` is a number, URL or
    branch as typed; None means the current branch of `directory`."""

    reference: str | None
    repo: str | None
    directory: str
    reply_to_comment: str | None = None


@dataclass(frozen=True)
class ProseWrite:
    verb: str
    # Text the call publishes, as far as this hook can read it.
    texts: tuple[str, ...]
    # Sources that exist but cannot be read here (stdin, an unreadable file).
    unread_sources: tuple[str, ...]
    # Set when the write lands on a PR whose state is worth checking.
    target: PullRequestTarget | None


def note(message: str) -> None:
    print("gh-pr-body-guard: %s" % message, file=sys.stderr)


def read_prose_file(
    value: str, cwd: str, variables: dict[str, str]
) -> tuple[list[str], list[str]]:
    """([text], [unread description]) for a body-file value."""
    source = resolve_body_source(value, cwd, variables)
    if source is None:
        return [], []  # a path only the shell can resolve is reported on stderr, not unread
    text, description = source
    if text is None:
        return [], [description]
    return [text], []


def cli_prose_write(
    segment: list[str], start: int, verb: str, directory: str, variables: dict[str, str]
) -> ProseWrite:
    """`gh pr comment|review` / `gh issue comment|create`, `start` pointing
    after the verb. Text comes from --body/-b, --title/-t and --body-file/-F;
    a repeated flag contributes every occurrence."""
    texts: list[str] = []
    unread: list[str] = []
    repo: str | None = None
    reference: str | None = None
    index = start
    while index < len(segment):
        word = segment[index]
        flag = word.split("=", 1)[0]
        if flag in PROSE_VALUE_FLAGS:
            value, index = flag_value(segment, index)
            if value is None:
                continue
            if flag in PROSE_TEXT_FLAGS:
                texts.append(literal_body(value))
            elif flag in PROSE_FILE_FLAGS:
                file_texts, file_unread = read_prose_file(value, directory, variables)
                texts += file_texts
                unread += file_unread
            else:
                repo = value
            continue
        if not word.startswith("-") and reference is None:
            reference = word
        index += 1
    is_pull_request_write = verb in ("gh pr comment", "gh pr review")
    target = PullRequestTarget(reference, repo, directory) if is_pull_request_write else None
    return ProseWrite(verb, tuple(texts), tuple(unread), target)


def api_prose_write(
    segment: list[str], start: int, directory: str, variables: dict[str, str]
) -> ProseWrite | None:
    """A `gh api` POST/PATCH/PUT with a `body` or `title` field, or an
    `--input` body. None when the call writes no text.

    Ceiling: an `--input` file is scanned as raw JSON text, so a path with its
    slashes escaped slips past; `gh api graphql` mutations are read only
    through their `-f`/`-F` fields.
    """
    call = parse_api_call(segment, start)
    if call.method not in API_WRITE_METHODS:
        return None
    texts: list[str] = []
    unread: list[str] = []
    for flag, key, value in call.fields:
        if key not in API_PROSE_FIELDS:
            continue
        # Only `-F`/`--field` reads `@file`; `-f` sends the text as written.
        if flag in ("-F", "--field") and value.startswith("@"):
            file_texts, file_unread = read_prose_file(value, directory, variables)
            texts += file_texts
            unread += file_unread
        else:
            texts.append(value)
    if call.input_source:
        file_texts, file_unread = read_prose_file(call.input_source, directory, variables)
        texts += file_texts
        unread += file_unread
    if not texts and not unread:
        return None
    target = None
    endpoint = (call.endpoint or "").split("?", 1)[0]
    conversation = PR_CONVERSATION_ENDPOINT.fullmatch(endpoint)
    if conversation:
        repo = conversation.group("repo")
        reply = REVIEW_THREAD_REPLY.fullmatch(endpoint)
        target = PullRequestTarget(
            conversation.group("number"),
            None if repo is None or "{" in repo else repo,
            directory,
            reply.group("comment") if reply else None,
        )
    return ProseWrite("gh api %s" % endpoint, tuple(texts), tuple(unread), target)


def prose_writes(command: str, cwd: str) -> list[ProseWrite]:
    """Every outward text write in the command that this guard covers."""
    writes: list[ProseWrite] = []
    variables = assigned_variables(command)
    for segment, gh_index, directory in gh_calls(command, cwd):
        subcommand, sub_index = gh_subcommand(segment, gh_index)
        if subcommand == "api":
            write = api_prose_write(segment, sub_index + 1, directory, variables)
            if write is not None:
                writes.append(write)
            continue
        if subcommand is None or sub_index + 1 >= len(segment):
            continue
        pair = (subcommand, segment[sub_index + 1])
        if pair in PROSE_WRITE_VERBS:
            verb = "gh %s %s" % pair
            writes.append(cli_prose_write(segment, sub_index + 2, verb, directory, variables))
    return writes


def run_gh(arguments: list[str], directory: str) -> str | None:
    """Stdout of a read-only `gh` call, or None when it fails, times out or
    `gh` is missing. The reason goes to stderr."""
    try:
        result = subprocess.run(
            ["gh", *arguments],
            cwd=directory if os.path.isdir(directory) else None,
            capture_output=True,
            text=True,
            timeout=LOOKUP_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.SubprocessError) as error:
        note("lookup `gh %s` failed (%s)" % (" ".join(arguments[:2]), type(error).__name__))
        return None
    if result.returncode != 0:
        note("lookup `gh %s` failed (exit %d)" % (" ".join(arguments[:2]), result.returncode))
        return None
    return result.stdout.strip()


def pull_request_state(target: PullRequestTarget) -> str | None:
    """OPEN, CLOSED or MERGED; None when it could not be looked up."""
    if target.reference and SHELL_EXPANSION.search(target.reference):
        note("PR state not checked, %s is only known to the shell" % target.reference)
        return None
    arguments = ["pr", "view"]
    if target.reference:
        arguments.append(target.reference)
    arguments += ["--json", "state", "--jq", ".state"]
    if target.repo:
        arguments += ["--repo", target.repo]
    state = run_gh(arguments, target.directory)
    if state == "":
        note("PR state not checked, `gh pr view` printed no state")
    return state or None


def replies_to_own_comment(target: PullRequestTarget) -> str | None:
    """The acting login when the review comment being replied to is its own;
    None when it is not, or a lookup failed."""
    if target.reply_to_comment is None:
        return None
    repo = target.repo or "{owner}/{repo}"
    author = run_gh(
        ["api", "repos/%s/pulls/comments/%s" % (repo, target.reply_to_comment), "--jq", ".user.login"],
        target.directory,
    )
    actor = run_gh(["api", "user", "--jq", ".login"], target.directory)
    return actor if author and author == actor else None


def refuse_plan_path(verb: str, fragment: str, line: str) -> int:
    print(
        "\n".join(
            [
                "BLOCKED: `%s` text names a path only this machine has (%s)." % (verb, fragment),
                "",
                "  %r" % line,
                "",
                "A reader on GitHub cannot open it. State the finding in the text itself, "
                "or cite a file and line in the repo.",
            ]
        ),
        file=sys.stderr,
    )
    return 2


def refuse_closed_pull_request(verb: str, state: str) -> int:
    print(
        "\n".join(
            [
                "BLOCKED: `%s` targets a PR whose state is %s." % (verb, state),
                "",
                "Nobody is watching a PR that is not open. Open a new PR or issue for "
                "follow-up work, or reopen this one first if the owner asked for that.",
            ]
        ),
        file=sys.stderr,
    )
    return 2


def check_prose_write(write: ProseWrite) -> int:
    for source in write.unread_sources:
        note("%s: %s, not checked for local paths" % (write.verb, source))
    for text in write.texts:
        for fragment in PLAN_FRAGMENTS:
            for line in text.splitlines():
                if fragment in line:
                    return refuse_plan_path(write.verb, fragment, line.strip())
    if write.target is None:
        return 0
    state = pull_request_state(write.target)
    if state in CLOSED_PR_STATES:
        return refuse_closed_pull_request(write.verb, state)
    own_login = replies_to_own_comment(write.target)
    if own_login:
        note("warning: replying to a thread %s started, not to a reviewer" % own_login)
    return 0


def has_trailing_marker(body: str) -> bool:
    lines = [line.strip() for line in body.splitlines() if line.strip()]
    return bool(lines) and lines[-1] == MARKER


def is_push_back_line(line: str) -> bool:
    # Normalize "Push back", "**Push back on:**" and "## Push back on" alike --
    # all three name the same required line in practice.
    return line.strip().lstrip("#*").strip().lower().startswith("push back")


def prose_paragraphs(lines: list[str]) -> list[str]:
    """Each prose paragraph of a markdown body as one string. Headings, table
    rows and fenced code are not prose; a list item is a paragraph of its own."""
    paragraphs: list[list[str]] = []
    current: list[str] = []
    is_in_fence = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("```"):
            is_in_fence = not is_in_fence
        is_boundary = (
            is_in_fence
            or stripped.startswith("```")
            or not stripped
            or stripped.startswith(("#", "|", "<!--"))
        )
        if is_boundary or LIST_ITEM.match(stripped):
            if current:
                paragraphs.append(current)
            current = [] if is_boundary else [stripped]
            continue
        current.append(stripped)
    if current:
        paragraphs.append(current)
    return [" ".join(paragraph) for paragraph in paragraphs]


def lint_findings(body: str) -> list[tuple[str, str]]:
    """(rule that failed, offending line) for every content-lint violation of
    an already-marked body."""
    findings: list[tuple[str, str]] = []
    lines = body.splitlines()

    for fragment in LOCAL_ONLY_FRAGMENTS:
        for line in lines:
            if fragment in line:
                findings.append(
                    ("names a path only this machine has (%s)" % fragment, line.strip())
                )
                break

    for line in lines:
        stripped = line.strip()
        for heading in FORBIDDEN_HEADINGS:
            if stripped.startswith(heading):
                findings.append(("`%s` heading is not allowed" % heading, stripped))

    # Capped per paragraph as well as per body: a body within its word budget is
    # still a wall when it arrives as one or two dense paragraphs.
    for paragraph in prose_paragraphs(lines):
        word_count = len(paragraph.split())
        if word_count > MAX_PARAGRAPH_WORDS:
            findings.append(
                (
                    "paragraph is %d words, over the %d-word cap -- split it or move "
                    "its numbers to a table" % (word_count, MAX_PARAGRAPH_WORDS),
                    paragraph[:120] + "...",
                )
            )

    body_word_count = len(body.replace(MARKER, "").split())
    if body_word_count > MAX_BODY_WORDS:
        findings.append(
            (
                "body is %d words, over the %d-word cap -- move detail to a PR comment"
                % (body_word_count, MAX_BODY_WORDS),
                "",
            )
        )

    if not any(is_push_back_line(line) for line in lines):
        findings.append(("no line states what to push back on", ""))

    return findings


def refuse_no_marker(source: str) -> int:
    print(
        "\n".join(
            [
                "BLOCKED: this PR body (%s) has no marker to check." % source,
                "",
                "Load the pr skill (/pr) and write the body through it. The guard can "
                "read only:",
                "  --body \"$(cat <<'TAG' ... TAG\n)\"   (quoted delimiter)",
                "  --body-file /absolute/path           (file must exist before this "
                "command runs)",
                "An unquoted heredoc, $(cat file), stdin and a file this same command "
                "writes are unreadable here.",
            ]
        ),
        file=sys.stderr,
    )
    return 2


def refuse_chained(write: str) -> int:
    print(
        "\n".join(
            [
                "BLOCKED: `%s` shares its Bash call with other commands." % write,
                "",
                "The owner's permission rule matches a PR write only when it is the whole "
                "command, so a chained one stalls on an approval nobody sees.",
                "Write the body with the Write tool, then run the PR command alone in its "
                "own Bash call, with absolute paths:",
                "  gh pr create --repo <owner>/<repo> --title ... --body-file /absolute/path",
            ]
        ),
        file=sys.stderr,
    )
    return 2


def refuse_lint(findings: list[tuple[str, str]]) -> int:
    lines = ["BLOCKED: this PR body breaks the pr skill's rules.", ""]
    for rule, line in findings:
        lines.append("  %s: %r" % (rule, line))
    lines += ["", "Fix the body and try again."]
    print("\n".join(lines), file=sys.stderr)
    return 2


def main() -> int:
    payload = json.load(sys.stdin)
    if payload.get("tool_name") != "Bash":
        return 0

    command = payload.get("tool_input", {}).get("command", "")
    cwd = payload.get("cwd") or os.getcwd()

    chained = chained_pr_write(command)
    if chained is not None:
        return refuse_chained(chained)

    for body, source in pr_body_calls(command, cwd):
        if body is None or not has_trailing_marker(body):
            return refuse_no_marker(source)
        findings = lint_findings(body)
        if findings:
            return refuse_lint(findings)

    for write in prose_writes(command, cwd):
        refusal = check_prose_write(write)
        if refusal:
            return refusal
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
