#!/usr/bin/python3
"""Claude Code PreToolUse guard: a plan file may not be written without
restamping `verified:` to today.

Status drift is what makes a plan file lie: the work moves on, the header does
not, and nothing catches it because nothing is checkable. Whether a status is
*correct* cannot be enforced mechanically. Whether someone looked at it today
can. `verified:` is that claim, and this refuses the write when the claim is
not renewed. It is a {by, at} mapping (flow, block or a list of them) compared
by its `at` date -- the latest one of a list -- or the older plain ISO date. A
refusal asks for the mapping; the plain date is still accepted.

Also refuses the other half of the same lie (plan-tree-hygiene/009): a write
that stamps `verified: <today>` while the body still carries the
`> **UNVERIFIED**` taint banner (`me plans taint`) asserts freshness and doubt
in the same file. This hook can't rewrite the content to remove the banner
for the writer -- a `PreToolUse` guard only ever allows or denies -- so it
makes the writer do it, which is the one shape of this rule that is actually
checkable: the banner must come off in the same edit that claims the file was
looked at.

Denies with exit 2 so the reason reaches Claude. Any internal failure exits 0 --
a broken guard must never wedge a session.

Shebang is an absolute path, not `env python3` -- see git-local-path-guard for why.
"""

from __future__ import annotations

import datetime as dt
import json
import os
import re
import sys
from typing import Final

# Escape hatch: set to any value to disable the rule for a session.
DISABLE: Final = "CLAUDE_SKIP_PLAN_GUARD"

EDIT_TOOLS: Final = ("Edit", "Write", "MultiEdit")
PLAN_ROOT: Final = os.path.expanduser("~/.plan")
# Working data and tooling that live in the tree but are not plans: sweep
# artifacts, audit output, backups, the search engine's own docs. A `verified:`
# stamp means nothing on those.
EXEMPT: Final = (
    os.path.join(PLAN_ROOT, "_private") + os.sep,
    os.path.join(PLAN_ROOT, ".index") + os.sep,
)

# `verified:` is a plain ISO date, or a {by, at} mapping (flow, block) or a list
# of them; the stamp's date is the `at` of a mapping, the latest one of a list.
VERIFIED_PLAIN: Final = re.compile(r"^verified:\s*[\"']?(\d{4}-\d{2}-\d{2})[\"']?\s*$")
VERIFIED_FLOW: Final = re.compile(r"^verified:\s*[\[{]")
VERIFIED_BLOCK: Final = re.compile(r"^verified:\s*$")
AT_DATE: Final = re.compile(r"\bat:\s*[\"']?(\d{4}-\d{2}-\d{2})")
REVIEW: Final = re.compile(r"^review:\s*\S", re.M)
# Mirrors tools/me/cmd/me/plans_taint.go's taintBannerRe byte for byte --
# the em dash is U+2014, not a hyphen.
BANNER: Final = re.compile(r"^> \*\*UNVERIFIED\*\* — .+\. Resolve before relying on this file\.$", re.M)


# What a refusal asks the writer to put in the file. `by` is the writer's own
# model id (claude-code/<model id>); a process names itself process:<verb>.
VERIFIED_FORM: Final = "verified: {{by: claude-code/<your model id>, at: {today}}}"


def verified_dates(text: str, is_fragment: bool = False) -> list[str]:
    """Every ISO date `verified:` stamps in text, in the plain, flow, block and
    list forms. A fragment (an Edit's new_string) may carry only an `at:` line
    of a block it edits, so those count too."""
    dates: list[str] = []
    is_in_block = False
    for line in text.split("\n"):
        plain = VERIFIED_PLAIN.match(line)
        if plain:
            dates.append(plain.group(1))
            is_in_block = False
        elif VERIFIED_FLOW.match(line):
            dates.extend(AT_DATE.findall(line))
            is_in_block = False
        elif VERIFIED_BLOCK.match(line):
            is_in_block = True
        elif is_in_block and (line == "" or line[0] in " \t" or line.startswith("- ")):
            dates.extend(AT_DATE.findall(line))
        else:
            is_in_block = False
            if is_fragment and re.match(r"^\s+(?:- )?at:", line):
                dates.extend(AT_DATE.findall(line))
    return dates


def verified_date(text: str, is_fragment: bool = False) -> str | None:
    """The latest date `verified:` stamps in text, or None."""
    dates = verified_dates(text, is_fragment)
    return max(dates) if dates else None


def is_reasoning_note(path: str) -> bool:
    """A note under <repo>/reasoning/ -- reasoning is the second path segment
    under PLAN_ROOT. Not a prefix EXEMPT can express, since <repo> varies."""
    segments = os.path.relpath(path, PLAN_ROOT).split(os.sep)
    return len(segments) >= 2 and segments[1] == "reasoning"


def edited_text(tool_name: str, tool_input: dict) -> str:
    """Whatever the tool is about to put into the file, as far as it is visible."""
    if tool_name == "Write":
        return tool_input.get("content", "")
    if tool_name == "Edit":
        return tool_input.get("new_string", "")
    if tool_name == "MultiEdit":
        return "\n".join(e.get("new_string", "") for e in tool_input.get("edits", []))
    return ""


def frontmatter(path: str) -> str:
    """The file's current frontmatter block, or '' when it has none."""
    try:
        with open(path) as fh:
            text = fh.read(8192)
    except OSError:
        return ""
    if not text.startswith("---\n"):
        return ""
    end = text.find("\n---\n", 4)
    return text[4:end] if end != -1 else ""


def apply_edit(current: str, old: str, new: str, replace_all: bool) -> str | None:
    """One Edit-shaped replacement applied to current, or None when it can't
    be applied (an empty or absent old_string) -- callers must treat None as
    "cannot determine the result", never as evidence either way."""
    if not old or old not in current:
        return None
    if replace_all:
        return current.replace(old, new)
    return current.replace(old, new, 1)


def resulting_text(tool_name: str, tool_input: dict, path: str) -> str | None:
    """The full file content this write would produce, or None when it can't
    be safely determined. Write hands over the whole file already; Edit and
    MultiEdit only carry a diff, so this reads the current file and replays
    the same replacement(s) the tool is about to make."""
    if tool_name == "Write":
        return tool_input.get("content", "")

    try:
        with open(path) as fh:
            current = fh.read()
    except OSError:
        return None

    if tool_name == "Edit":
        return apply_edit(current, tool_input.get("old_string", ""),
                           tool_input.get("new_string", ""), tool_input.get("replace_all", False))

    if tool_name == "MultiEdit":
        text = current
        for edit in tool_input.get("edits", []):
            text = apply_edit(text, edit.get("old_string", ""), edit.get("new_string", ""),
                               edit.get("replace_all", False))
            if text is None:
                return None
        return text

    return None


def frontmatter_of(text: str) -> str:
    """Same slice as frontmatter(path), for content not yet on disk."""
    if not text.startswith("---\n"):
        return ""
    end = text.find("\n---\n", 4)
    return text[4:end] if end != -1 else ""


def banner_contradiction(path: str, tool_name: str, tool_input: dict, today: str) -> str | None:
    """Why this write asserts freshness and doubt at once, or None. Only
    fires when the resulting file would claim `verified: <today>` while its
    body still carries the taint banner -- a write that neither restamps nor
    is tainted has nothing to contradict."""
    text = resulting_text(tool_name, tool_input, path)
    if text is None:
        return None
    if verified_date(frontmatter_of(text)) != today:
        return None
    if not BANNER.search(text):
        return None
    return (
        "this edit stamps `verified: %s` but the body still carries the\n"
        "`> **UNVERIFIED**` taint banner. Remove the banner in the same edit --\n"
        "a write can't claim the plan was looked at and still be in doubt."
        % today
    )


def stale(path: str, incoming: str, today: str) -> str | None:
    """Why this write should be refused, or None to allow it."""
    # A new file must arrive already stamped; there is nothing on disk to renew.
    if not os.path.exists(path):
        if verified_date(incoming, is_fragment=True) or REVIEW.search(incoming):
            return None
        return "a new plan file must carry `%s` (or a `review:` reason)" % VERIFIED_FORM.format(today=today)

    if verified_date(incoming, is_fragment=True) or REVIEW.search(incoming):
        return None

    current_frontmatter = frontmatter(path)
    if REVIEW.search(current_frontmatter):
        return None  # `review:` already records that the status is unverified

    current = verified_date(current_frontmatter)
    if current == today:
        return None  # already renewed earlier in the same day

    was = current or "absent"
    return (
        "this edit does not restamp `verified:` (currently %s, today is %s).\n"
        "Set `%s` in the same edit, or set `review:` with a\n"
        "reason if the status is known-wrong and you are not fixing it now."
        % (was, today, VERIFIED_FORM.format(today=today))
    )


def main() -> int:
    if os.environ.get(DISABLE):
        return 0

    payload = json.load(sys.stdin)
    tool_name = payload.get("tool_name")
    if tool_name not in EDIT_TOOLS:
        return 0

    tool_input = payload.get("tool_input", {})
    path = os.path.realpath(tool_input.get("file_path", ""))
    if not path.startswith(PLAN_ROOT + os.sep) or not path.endswith(".md"):
        return 0
    if path.startswith(EXEMPT) or is_reasoning_note(path):
        return 0

    today = dt.date.today().isoformat()
    reason = stale(path, edited_text(tool_name, tool_input), today)
    if reason is None:
        reason = banner_contradiction(path, tool_name, tool_input, today)
    if reason is None:
        return 0

    print(
        "BLOCKED: %s -- %s\n\nSet %s=1 to override for this session."
        % (os.path.relpath(path, PLAN_ROOT), reason, DISABLE),
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(0)
