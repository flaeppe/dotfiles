{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
  "effortLevel": "high",
  "autoCompactWindow": "300k",
  "tui": "fullscreen",
  "editorMode": "vim",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "pg@aiguide": true,
    "context7-plugin@context7-marketplace": true
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(git tag*)",
      "Bash(git stash list*)",
      "Bash(gh browse*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue status*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr status*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh repo view*)",
      "Bash(gh repo list*)",
      "Bash(gh search*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh label list*)",
      "Bash(direnv status*)",
      "Bash(af *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo rm -rf /*)",
      "Bash(kubectl*)",
      "Bash(* kubectl*)"
    ],
    "ask": [
      "Bash(terraform*)",
      "Bash(* terraform*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-code-discovery-gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/gcloud-command-gate"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/git-local-path-guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/protected-path-guard"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/edit-content-guard"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/plan-verified-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/format-after-edit"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-end-inbox"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.local/state/claude && jq -c '{t:(now|todate),tool:.tool_name,cmd:(.tool_input.command // .tool_input.file_path // null)}' >> ~/.local/state/claude/permission-prompts.jsonl",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      }
    ]
  }
}
