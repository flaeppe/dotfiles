{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "bash ~/.claude/subagent-statusline.sh"
  },
  "effortLevel": "xhigh",
  "autoCompactWindow": 450000,
  "tui": "fullscreen",
  "editorMode": "vim",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "pg@aiguide": false,
    "context7-plugin@context7-marketplace": true
  },
  "skillOverrides": {
    "dataviz": "off",
    "update-config": "off",
    "claude-in-chrome": "off",
    "run": "off",
    "loop": "off",
    "workflow-authoring": "off",
    "fewer-permission-prompts": "off"
  },
  "deniedMcpServers": [
    { "serverName": "claude.ai Notion" },
    { "serverName": "claude.ai Google Calendar" },
    { "serverName": "claude.ai Google Drive" },
    { "serverName": "claude.ai Google Sheets" },
    { "serverName": "claude.ai Google Docs" },
    { "serverName": "claude.ai Figma" },
    { "serverName": "claude.ai Excalidraw" },
    { "serverName": "claude.ai Canva" },
    { "serverName": "claude.ai meta" },
    { "serverName": "claude.ai Higgsfield" },
    { "serverName": "claude.ai Claude Docs" }
  ],
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(git tag*)",
      "Bash(git stash list*)",
      "Bash(gh browse*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue status*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr status*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh repo view*)",
      "Bash(gh repo list*)",
      "Bash(gh search*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh label list*)",
      "Bash(direnv status*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo rm -rf /*)",
      "Bash(kubectl*)",
      "Bash(* kubectl*)",
      "Artifact",
      "Workflow",
      "ReportFindings",
      "ShareOnboardingGuide",
      "SendFeedback"
    ],
    "ask": [
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-code-discovery-gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/gcloud-command-gate"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/git-local-path-guard"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/commit-denylist-guard"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/log-assertion-check"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/toolchain-path-guard"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/gh-pr-body-guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/protected-path-guard"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/edit-content-guard"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/plan-verified-guard"
          },
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/plan-check-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "env -u DEVELOPER_DIR ~/.claude/hooks/format-after-edit"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-end-inbox"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/me journal permission --hook",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-mark waiting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-mark done"
          },
          {
            "type": "command",
            "command": "~/.local/bin/me journal render --hook",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-mark clear"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-registry"
          }
        ]
      }
    ]
  }
}
