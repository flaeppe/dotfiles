#!/usr/bin/env bash
# Blocks a commit whose message matches a term in the machine-local
# denylist -- but only inside a repo opted in via a `repo:<absolute path>`
# line in that same file (see pre-commit for why). Silently allows
# everything when the denylist file is absent.
set -euo pipefail

DENYLIST="$HOME/.config/git-banned-words"
[ -f "$DENYLIST" ] || exit 0

repo="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
grep -Fxq "repo:$repo" "$DENYLIST" || exit 0

pattern="$(grep -v '^#' "$DENYLIST" | grep -v '^$' | grep -v '^repo:' | paste -sd'|' -)"
[ -n "$pattern" ] || exit 0

if grep -Eiq "$pattern" "$1"; then
  echo "commit blocked: commit message matches a denylisted term ($DENYLIST)" >&2
  exit 1
fi
